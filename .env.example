# LibreCrawl Docker Environment Configuration

# Host binding for the application
# - 127.0.0.1 = localhost only (local development)
# - 0.0.0.0 = all interfaces (production, accessible from network)
HOST_BINDING=127.0.0.1

# The port binding for the application
EXTERNAL_PORT=5000

# Secret key used to sign session cookies. MUST be a unique random value in
# production — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left unset, an ephemeral random key is generated at startup (secure, but
# sessions will not survive a restart).
# SECRET_KEY=

# Local mode - enables auto-login with admin access, no rate limits
# WARNING: "true" disables ALL authentication and grants every visitor admin
# access. Only enable for local development. Keep "false" for any networked or
# production deployment.
LOCAL_MODE=false

# Disable user registrations
# Set to "true" to prevent new users from registering
# Useful for production environments where you only want existing users
REGISTRATION_DISABLED=false

# DANGEROUSLY SKIP AUTH
# Set to "true" to let anyone log in as any username with no password.
# The username is only used to keep per-user sessions separate.
# DO NOT enable on a public network or in production.
DANGEROUSLY_SKIP_AUTH=false

# Disable guest login. Guests can crawl without an account, limited to 3 crawls per 24 hours.
DISABLE_GUEST=false

# Demo mode: 1.5GB memory limit per user, crawls stop automatically at the limit
DEMO_MODE=false

# Address the Python server listens on. Default 127.0.0.1 = this machine only.
# Use 0.0.0.0 to accept connections from the network. Docker already listens on 0.0.0.0
# inside the container, and HOST_BINDING above controls what the host exposes.
# BIND_HOST=127.0.0.1

# Local mode refuses to listen beyond localhost unless this is "true" (local mode gives
# every visitor admin access)
# LOCAL_MODE_ALLOW_LAN=false

# Set to "true" only behind a reverse proxy you control (e.g. Cloudflare). Guest limits then
# use the client IP from CF-Connecting-IP or X-Forwarded-For. Otherwise those headers are ignored.
# TRUST_PROXY=false

# Email Configuration for verification emails
# SMTP server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@librecrawl.com
SMTP_FROM_NAME=LibreCrawl

# Base URLs for email links (used to generate verification links)
MAIN_APP_URL=https://crawl.librecrawl.com
WORKSHOP_APP_URL=https://workshop.librecrawl.com
